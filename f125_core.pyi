from collections.abc import Sequence
from typing import Any
from pathlib import Path

class UdpReceiver:
    def __init__(self, host: str, port: int, record_dir: Path | None = None, pit_loss: int = 20000) -> None: ...
    @property
    def port(self) -> int: ...
    def snapshot(self) -> dict[str, Any]: ...
    def drain_udp_actions(self) -> list[int]: ...
    def analysis(self) -> dict[str, Any]: ...
    def close(self) -> None: ...

class Replay:
    def __init__(self, dir: Path) -> None: ...
    @staticmethod
    def for_handoff(dir: Path) -> "Replay": ...
    @property
    def duration_ms(self) -> int: ...
    @property
    def pit_loss_ms(self) -> int: ...
    def advance(self, ms: int) -> dict[str, Any]: ...
    def analysis(self) -> dict[str, Any]: ...

def read_header(packet: bytes) -> tuple[int, int, int, int]: ...
def timing_order(gaps_ms: list[int]) -> list[tuple[int, int]]: ...
def closing_pace(gap_ms: int, leading_lap: int, following_lap: int) -> tuple[int, int | None] | None: ...
def battle_projection(gap_ms: int, gain_per_10s: int, lap_ms: int) -> tuple[int, int | None] | None: ...
def race_forecast(entries: list[tuple[str, int, str, int, int, list[tuple[int, int]]]], player: int,
                  distance: tuple[int, int], conditions: tuple[int, bool, bool], pit_loss_ms: int,
                  scheduled: Sequence[tuple[int, str]], telemetry: tuple[list[tuple[int,int]], list[tuple[str,int,int]], list[tuple[str,int]], tuple[int,int] | None] | None = None,
                  observations: tuple[list[tuple[str,list[tuple[str,int,int]],int,bool,bool,int|None,list[tuple[str,int,int]]]],int|None] | None = None,
                  proposal: tuple[int,str] | None = None,
                  quick_losses: Sequence[Sequence[tuple[int,int]] | None] | None = None, serviced: bool = False, advisor_choices: list[tuple[int,str]|None] | None = None) -> dict[str, Any]: ...

def reference_pace(ms: int, compound: str, age: int, surface: int) -> int: ...
__version__: str
